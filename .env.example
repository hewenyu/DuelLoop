# Copy to .env and supply your own credentials. Never commit .env.
TYPESAFE_API_KEY=
DEEPSEEK_API_KEY=
# Verify service model availability before pinning these values.
DUELLOOP_JEV_MODEL=jev-1.13.0
DUELLOOP_PI_PROVIDER=deepseek
DUELLOOP_PI_MODEL=deepseek-flash
DUELLOOP_PI_KEY_ENV=DEEPSEEK_API_KEY
# Repository experiment scripts require DUELLOOP_LIVE=1 for paid calls.
# This is not a global SDK/CLI switch; their model configuration controls calls.
# The controlled closed-loop experiment also needs DUELLOOP_LIVE_CLOSED_LOOP=1.
